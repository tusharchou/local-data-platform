{
  "identifier": "order_lines",
  "who": "restaurant owner",
  "what": "the lines of the orders of one batch, as exported, added to the raw order lines",
  "where": "landing/order_lines.csv",
  "when": "every batch",
  "how": "batch append",
  "metadata": {
    "source": {
      "name": "order_lines",
      "format": "CSV",
      "path": "../landing/order_lines.csv"
    },
    "target": {
      "name": "order_lines",
      "format": "ICEBERG",
      "catalog": {
        "identifier": "raw",
        "warehouse_path": "../warehouse"
      },
      "write_mode": "append"
    },
    "quality": {
      "on_failure": "fail",
      "checks": [
        {"check": "row_count", "min": 1},
        {"check": "not_null", "columns": ["order_id", "line_no", "menu_item_id", "quantity", "unit_price"]},
        {"check": "range", "column": "quantity", "min": 1},
        {"check": "schema", "columns": {
          "order_id": "string", "line_no": "int64", "menu_item_id": "string", "quantity": "int64",
          "unit_price": "double"}}
      ]
    },
    "observability": {"sinks": ["jsonl"]}
  }
}
