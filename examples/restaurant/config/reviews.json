{
  "identifier": "reviews",
  "who": "restaurant owner",
  "what": "the reviews that customers left, as exported",
  "where": "landing/reviews.csv",
  "when": "whenever a new export is downloaded",
  "how": "batch overwrite",
  "metadata": {
    "source": {
      "name": "reviews",
      "format": "CSV",
      "path": "../landing/reviews.csv"
    },
    "target": {
      "name": "reviews",
      "format": "ICEBERG",
      "catalog": {
        "identifier": "raw",
        "warehouse_path": "../warehouse"
      },
      "write_mode": "overwrite"
    },
    "quality": {
      "on_failure": "fail",
      "checks": [
        {"check": "row_count", "min": 1},
        {"check": "not_null", "columns": ["review_id", "order_id", "restaurant_id", "rating"]},
        {"check": "unique", "columns": ["review_id"]},
        {"check": "range", "column": "rating", "min": 1, "max": 5},
        {"check": "schema", "columns": {
          "review_id": "string", "order_id": "string", "customer_id": "string", "restaurant_id": "string",
          "rating": "int64", "comment": "string", "reviewed_at": "timestamp[s]"}}
      ]
    },
    "observability": {"sinks": ["jsonl"]}
  }
}
